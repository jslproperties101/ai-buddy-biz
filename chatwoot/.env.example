# Copy to `.env` on the server and fill in. NEVER commit the real .env (see .gitignore).
#
# Generate secrets with:  openssl rand -hex 64   (SECRET_KEY_BASE)   and   openssl rand -hex 24   (passwords)

# --- Your domain (DNS A record must point at the server) ---
CHATWOOT_DOMAIN=chat.example.com
FRONTEND_URL=https://chat.example.com

# --- Chatwoot core ---
# Pin a released version once it is running (e.g. v4.x.y) instead of `latest`, so upgrades are deliberate.
CHATWOOT_VERSION=latest
SECRET_KEY_BASE=replace-with-openssl-rand-hex-64
FORCE_SSL=true
# First admin is created in the browser; then close sign-ups so strangers cannot create accounts.
ENABLE_ACCOUNT_SIGNUP=false
DEFAULT_LOCALE=en

# --- Postgres ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=chatwoot
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=replace-with-strong-password

# --- Redis ---
REDIS_PASSWORD=replace-with-strong-password
# Must contain the same password as REDIS_PASSWORD
REDIS_URL=redis://:replace-with-strong-password@redis:6379

# --- Outgoing email (agent notifications, password resets). Fill in when ready. ---
MAILER_SENDER_EMAIL=Ai buddy Biz <support@example.com>
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=login
SMTP_ENABLE_STARTTLS_AUTO=true

# --- WhatsApp: nothing to set here. The Meta Cloud API channel is added inside Chatwoot
#     (Settings → Inboxes → Add → WhatsApp). Until the Meta number exists, use test mode — see README.md.
